# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*keystore*
*wallet*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual env ---
.venv/
venv/

# --- Data (generated; keep directory placeholders only) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.sqlite
*.sqlite3
*.db

# --- Logs ---
logs/
*.log

# --- Backups, registry exports, merge leftovers ---
*.bak
*.backup
*.orig
*.rej
*.reg

# --- Claude Code: personal settings stay local (.claude/settings.json is shared) ---
.claude/settings.local.json

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
