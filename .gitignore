# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*keystore*
*wallet*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual env ---
.venv/
venv/

