# Copy to .env and adjust. .env is git-ignored.
# v0.1 uses only public, unauthenticated read endpoints: NO keys are required.
# Never put private keys, seed phrases or API secrets in this repository.

# Polymarket public endpoints (override only for testing)
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# HTTP behaviour
MONEYLAB_HTTP_TIMEOUT=10
MONEYLAB_HTTP_RETRIES=2

# Recorder (v0.3). source: polymarket | fixture. condition ids: comma-separated.
MONEYLAB_RECORDER_SOURCE=polymarket
MONEYLAB_RECORDER_CONDITION_IDS=
MONEYLAB_RECORDER_INTERVAL=60
MONEYLAB_RECORDER_METADATA_REFRESH=3600
MONEYLAB_RECORDER_MAX_FAILURES=30

# Storage / logging
MONEYLAB_DATA_DIR=data
MONEYLAB_LOG_LEVEL=INFO
